# Copy to .env and fill in every value.
# Docker reads values literally: no quotes, no inline comments.

# --- Domain / TLS ---------------------------------------------------------
# DNS A/AAAA record for this host must point at your server before first start.
DOMAIN=
ACME_EMAIL=

# --- Application ----------------------------------------------------------
# Generate: openssl rand -base64 32   (min 32 chars)
SECRET_KEY=
# Pin a release in production, e.g. 0.9.0. See github.com/QuackbackIO/quackback/releases
QUACKBACK_TAG=latest
# Optional recovery: lets this address finish setup if the first account is wrong
SETUP_OWNER_EMAIL=

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=quackback
# Generate: openssl rand -hex 24  (hex avoids characters that break the connection URL)
POSTGRES_PASSWORD=
POSTGRES_DB=quackback

# --- Object storage: Cloudflare R2 ----------------------------------------
S3_ENDPOINT=
S3_BUCKET=quackback-alesia
S3_REGION=auto
# R2 > Manage API tokens > Object Read & Write, scoped to the bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (configure exactly ONE provider; blank = emails logged to console) -
EMAIL_RESEND_API_KEY=
EMAIL_FROM=

# --- AI features (optional) ----------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=